{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"files": {
		"includes": ["**", "!**/coverage", "!**/.yalc", "!**/dist"]
	},
	"css": { "parser": { "tailwindDirectives": true } },
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"formatter": {
		"enabled": true,
		"includes": [
			"**",
			"!**/package.json",
			"!**/*.md",
			"!**/*.yml",
			"!**/*.yaml"
		]
	}
}
